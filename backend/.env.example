# ============================================================
# 校园创新创业项目管理平台 - 环境变量配置模板
# 使用方法：复制本文件为 .env，然后修改其中的配置项
# ⚠️ .env 文件包含敏感信息，严禁提交到版本控制（已加入 .gitignore）
# ============================================================

# ========== 应用基本配置 ==========
DEBUG=True
HOST=0.0.0.0
PORT=8000
# CORS域名白名单（逗号分隔，生产环境必须精确配置）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ========== MySQL 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# ⚠️ 必须修改为你的实际MySQL密码（生产环境请使用强密码：大小写+数字+特殊字符≥12位）
DB_PASSWORD=your_mysql_password_here
DB_NAME=ie_project_db
DB_CHARSET=utf8mb4

# ========== Redis 配置 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 如果Redis有密码，填写；否则留空
REDIS_PASSWORD=
REDIS_DB=0

# ========== JWT 认证配置 ==========
# ⚠️ 生产环境必须修改为足够随机的长字符串（建议：openssl rand -hex 32）
JWT_SECRET_KEY=change_me_to_a_long_random_string_e_g_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# 访问令牌过期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 刷新令牌过期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 文件上传 ==========
UPLOAD_DIR=static/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.zip,.rar

# ========== 全文检索 ==========
WHOOSH_INDEX_DIR=static/whoosh_index
